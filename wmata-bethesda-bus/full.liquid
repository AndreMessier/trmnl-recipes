<div class="layout layout--col">
  {% assign all = data.IDX_0.Predictions | concat: data.IDX_1.Predictions | concat: data.IDX_2.Predictions | sort: 'Minutes' %}
  <table class="table">
    <thead>
      <tr>
        <th><span class="title">Route</span></th>
        <th><span class="title">Direction</span></th>
        <th><span class="title">Min</span></th>
      </tr>
    </thead>
    <tbody>
      {% if all.size == 0 %}
        <tr><td colspan="3"><span class="label label--gray-out">No predictions available</span></td></tr>
      {% else %}
        {% for p in all limit: 8 %}
        <tr>
          <td><span class="line">{{ p.RouteID }}</span></td>
          <td><span class="label">{{ p.DirectionText }}</span></td>
          {% if p.Minutes == 0 %}
          <td><span class="label label--inverted" style="width:fit-content;">ARR</span></td>
          {% else %}
          <td><span class="label">{{ p.Minutes }}</span></td>
          {% endif %}
        </tr>
        {% endfor %}
      {% endif %}
    </tbody>
  </table>
</div>
<div class="title_bar">
  <img class="image" src="https://upload.wikimedia.org/wikipedia/commons/0/0a/WMATA_Metro_Logo_small.svg" />
  <span class="title">Bethesda Station</span>
  <span class="instance">Refreshed at {{ 'now' | date: '%H:%M' }}</span>
</div>